{
  "name": "cardapio",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {"crons": ["0 6 * * *"]},
  "d1_databases": [
    {
      "binding": "DOPPIO_DB",
      "database_name": "doppio-admin",
      "database_id": "ecc62d72-0d68-49a4-8f38-94edbc20d971"
    }
  ]
}
